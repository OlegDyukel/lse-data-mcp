# Reference only: the server does not load this file automatically.
#
# Prefer `lse-data-mcp login`, which stores the key in the operating system's own
# credential store instead of in plain text on disk. Set LSE_API_KEY directly when
# there is no credential store to use, such as a container or a headless Linux host.
LSE_API_KEY=replace_with_your_own_key
LSE_TIMEOUT_SECONDS=60
LSE_MAX_RESPONSE_BYTES=131072
